# =============================================================================
# SynapseHSG Pipeline Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Service Endpoints (LLM Services)
# -----------------------------------------------------------------------------

# [TRIPLES_BUILD] KG Extraction / Triple Construction
# Used for extracting knowledge graph triples from claims
export TRIPLES_BUILD_BASE_URL="http://localhost:3030/v1"
export TRIPLES_BUILD_API_KEY="your_api_key"
export TRIPLES_BUILD_MODEL="Qwen3.5-27B"

# [VISION] Visual Semantics Parsing
# Used for OCR, chart recognition, and visual summary extraction from slides/paper pages
export VISION_BASE_URL="http://localhost:1089/v1"
export VISION_API_KEY="your_api_key"
export VISION_MODEL="Qwen3.5-27B"

# [ASR] Automatic Speech Recognition
# Used for audio-to-text transcription with timestamps
export ASR_BASE_URL="http://localhost:2097/v1"
export ASR_API_KEY="your_api_key"
export ASR_MODEL="whisper-large-v3"
export ASR_LANGUAGE="en"
export ASR_TRANSCRIBE_PATH="/audio/transcriptions"

# [EMBED] Text Embedding Service
# Used for dense vector similarity (paper repair, semantic search)
export EMBED_BASE_URL="http://localhost:2097/v1"
export EMBED_API_KEY="your_api_key"
export EMBED_MODEL="bge-m3"
export EMBED_BATCH_SIZE=1

# -----------------------------------------------------------------------------
# Global LLM Concurrency Control
# -----------------------------------------------------------------------------
# Each LLM service has its own global executor with independent concurrency control.
# All sessions share these executors, ensuring predictable resource usage.

# Session-level parallelism: number of sessions processed concurrently
export SESSION_CONCURRENCY=4
export SESSION_MIN_INTERVAL_MS=300000

# [TRIPLES_BUILD] Global concurrent calls across ALL sessions
export TRIPLES_BUILD_CONCURRENCY=10
export TRIPLES_BUILD_MIN_INTERVAL_MS=800

# [VISION] Global concurrent calls across ALL sessions
export VISION_LLM_CONCURRENCY=20
export VISION_LLM_MIN_INTERVAL_MS=200

# [ASR] Global concurrent calls across ALL sessions
export ASR_CONCURRENCY=1
export ASR_MIN_INTERVAL_MS=100

# Global LLM request spacing (fallback for other LLM calls)
export LLM_MIN_INTERVAL_MS=300

# -----------------------------------------------------------------------------
# Token Limits for TRIPLES_BUILD LLM
# -----------------------------------------------------------------------------
export TRIPLES_BUILD_MAX_TOKENS=32768
export TRIPLES_BUILD_RETRY_MAX_TOKENS=32768

# -----------------------------------------------------------------------------
# LLM Retry Policy
# -----------------------------------------------------------------------------
export LLM_MAX_RETRIES=3
export LLM_RETRY_BASE_MS=800
export LLM_RETRY_MAX_MS=8000
export LLM_RETRY_JITTER_MS=300

# -----------------------------------------------------------------------------
# ASR Speech Onset Detection
# -----------------------------------------------------------------------------
# AUTO (default) | OFF | FORCE_SEC:<seconds>
export ASR_SPEECH_ONSET_MODE="AUTO"
export ASR_SPEECH_ONSET_PROBE_SEC="35"
export ASR_SPEECH_ONSET_MAX_SEC="20"
# Internal sub-chunk size for word-level timestamp requests (seconds)
export ASR_WORD_MAX_CHUNK_SEC="30"

# -----------------------------------------------------------------------------
# Visual Semantics Configuration
# -----------------------------------------------------------------------------
# Number of visual regions per slide/paper page to run multimodal parsing on
export VISION_SEMANTICS_REGIONS_PER_SLIDE=3
export VISION_SEMANTICS_REGIONS_PER_PAPER_PAGE=2
export VISION_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# TRIPLES_BUILD / KG Extraction Configuration
# -----------------------------------------------------------------------------
# Dynamic context expansion: stop when coverage passes (1=on, 0=off)
export STOP_ON_COVERAGE=0

# Per-claim input chunking budget (approx tokens before image parts)
# If exceeded, claim window is auto-split into multiple shard requests
export TRIPLES_BUILD_CLAIM_INPUT_TOKEN_BUDGET=12000
export TRIPLES_BUILD_CLAIM_MAX_SHARDS=6

# High-recall KG knobs (semantic limits per category)
export SEM_LIMIT_CLAIM=14
export SEM_LIMIT_METHOD=16
export SEM_LIMIT_RESULT=20
export SEM_LIMIT_METRIC=20
export SEM_LIMIT_LIMITATION=10

# Claim window size limits
export CLAIM_WINDOW_MAX_CHUNKS=12
export CLAIM_WINDOW_MAX_UTTERANCES=14
export CLAIM_WINDOW_MAX_SLIDES=8
export CLAIM_WINDOW_MAX_REGIONS=14
export CLAIM_WINDOW_MAX_EVENTS=14
export CLAIM_WINDOW_MAX_SIGNALS=14

# Paper visual processing
export PAPER_VISUAL_REGIONS_PER_PAGE=3
export PAPER_REGIONS_PER_NODE_PAGE=1

# -----------------------------------------------------------------------------
# Context & Token Limits
# -----------------------------------------------------------------------------
# Context guard: when gateway reports "input length too long", auto-retry with reduced max_tokens
export LLM_CONTEXT_MAX_TOKENS=8192
export LLM_CONTEXT_RESERVE_TOKENS=12288
